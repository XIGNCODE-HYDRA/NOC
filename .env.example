# Copy this file to .env for local development
# NEVER commit .env or .env.production to git

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/noc_dev

# Session secret — use any random string in development
# In production run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change_me_to_a_random_64_char_string_in_production

# Set to 'production' on the VPS
NODE_ENV=development

# API server port (optional — defaults to 8080)
# PORT=8080
